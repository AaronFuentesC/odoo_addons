<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- VISTA TREE (LISTADO) -->
    <record id="view_vehiculo_tree" model="ir.ui.view">
        <field name="name">gestor_vehiculos_aaron.vehiculo.tree</field>
        <field name="model">gestor_vehiculos_aaron.vehiculo</field>
        <field name="arch" type="xml">
            <list>
                <field name="matricula"/>
                <field name="marca"/>
                <field name="modelo"/>
                <field name="kilometros"/>
                <field name="empleado_id"/>
                <field name="disponible"/>


            </list>
        </field>
    </record>

    <!-- VISTA FORM -->
    <record id="view_vehiculo_form" model="ir.ui.view">
        <field name="name">gestor_vehiculos_aaron.vehiculo.form</field>
        <field name="model">gestor_vehiculos_aaron.vehiculo</field>
        <field name="arch" type="xml">
            <form string="Vehículo">
                <sheet>

                    <group>
                        <field name="matricula"/>
                        <field name="marca"/>
                        <field name="modelo"/>
                        <field name="kilometros"/>
                        <field name="empleado_id"/>
                    </group>

                    <notebook>
                        <page string="Histórico">
                            <field name="historico_ids">
                                <list>
                                    <field name="empleado_id"/>
                                    <field name="fecha_inicio"/>
                                    <field name="fecha_fin"/>
                                    <field name="activo"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>


    <!-- ACCIÓN -->
    <record id="action_vehiculos" model="ir.actions.act_window">
        <field name="name">Vehículos</field>
        <field name="res_model">gestor_vehiculos_aaron.vehiculo</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('activo','=',True)]</field>
    </record>

    <!-- MENÚ -->
    <menuitem id="menu_gestor_vehiculos_root"
            name="Gestión Vehículos"
            sequence="10"/>

    <menuitem id="menu_gestor_vehiculos"
            name="Vehículos"
            parent="menu_gestor_vehiculos_root"
            action="action_vehiculos"
            sequence="10"/>

</odoo>
