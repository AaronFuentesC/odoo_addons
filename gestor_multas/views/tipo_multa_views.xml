<odoo>
    <!-- Vista LIST -->
    <record id="view_gestion_tipo_multa_list" model="ir.ui.view">
        <field name="name">gestion.tipo.multa.list</field>
        <field name="model">gestion.tipo_multa</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Vista FORM -->
    <record id="view_gestion_tipo_multa_form" model="ir.ui.view">
        <field name="name">gestion.tipo.multa.form</field>
        <field name="model">gestion.tipo_multa</field>
        <field name="arch" type="xml">
            <form string="Tipo de Multa">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_gestion_tipo_multa" model="ir.actions.act_window">
        <field name="name">Tipos de Multa</field>
        <field name="res_model">gestion.tipo_multa</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
