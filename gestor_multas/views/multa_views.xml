<odoo>
    <!-- Vista LIST de multas -->
    <record id="view_gestion_multa_list" model="ir.ui.view">
        <field name="name">gestion.multa.list</field>
        <field name="model">gestion.multa</field>
        <field name="arch" type="xml">
            <list>
                <field name="fecha"/>
                <field name="empleado_id"/>
                <field name="tipo_multa_id"/>
                <field name="importe"/>
                <field name="pagada"/>
            </list>
        </field>
    </record>

    <!-- Vista FORM de multas -->
    <record id="view_gestion_multa_form" model="ir.ui.view">
        <field name="name">gestion.multa.form</field>
        <field name="model">gestion.multa</field>
        <field name="arch" type="xml">
            <form string="Multa">
                <sheet>
                    <group>
                        <field name="fecha"/>
                        <field name="empleado_id"/>
                        <field name="tipo_multa_id"/>
                    </group>
                    <group>
                        <field name="descripcion"/>
                        <field name="importe"/>
                        <field name="pagada"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_gestion_multa" model="ir.actions.act_window">
        <field name="name">Multas</field>
        <field name="res_model">gestion.multa</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
