<odoo>
    <record id="view_employee_form_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.multas</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Multas" invisible="not multa_ids">
                    <field name="multa_ids">
                        <list>
                            <field name="fecha"/>
                            <field name="tipo_multa_id"/>
                            <field name="importe"/>
                            <field name="pagada"/>
                        </list>
                        <form>
                            <group>
                                <field name="fecha"/>
                                <field name="descripcion"/>
                                <field name="tipo_multa_id"/>
                                <field name="importe"/>
                                <field name="pagada"/>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
